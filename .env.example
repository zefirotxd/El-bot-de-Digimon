# Variables de entorno.
#
# Este fichero es la PLANTILLA: explica qué es cada cosa. Los valores reales van en
# `.env` en local, que está en `.gitignore` y nunca se sube, y en Fly van como
# secretos:
#
#     fly secrets set DISCORD_TOKEN=... DISCORD_CLIENT_ID=...

# Token del bot (Developer Portal > Bot > Token).
#
# Es una credencial: si se filtra, cualquiera puede conectarse como tu bot y
# controlarlo. La regenerar en el portal es un clic.
DISCORD_TOKEN=

# ID de la aplicación (Developer Portal > General Information > Application ID).
DISCORD_CLIENT_ID=

# ID del servidor de pruebas, para que los comandos aparezcan al instante.
#
# Déjalo vacío en producción: con guild vacío los comandos se registran globalmente
# y tardan hasta una hora en aparecer. Con guild puesto el registro es inmediato,
# pero solo sirve en ese servidor.
DISCORD_GUILD_ID=

# Ruta del archivo SQLite, relativa al directorio de trabajo.
#
# En Fly el directorio de trabajo es `/app` y esta ruta cae dentro del volumen
# montado en `/app/data`. Si la cambias a algo fuera de ahí, la base quedaría en el
# sistema de archivos efímero de la máquina y se perdería en cada reinicio.
DATABASE_PATH=./data/digimon.db

# Cuántos Digimon pueden pelear a la vez (el equipo activo).
MAX_PARTY_SIZE=4

# Capacidad del PC, donde depositas los que no son.
PC_CAPACITY=200

# Mostrar las ilustraciones de referencia DENTRO de los embeds.
#
# Vacío o `0` = NO se muestran, y la ficha lleva un botón a la página de origen.
# Es lo correcto: el arte de Digimon es material de Bandai y Toei y la fuente lo
# marca como no libre.
#
# `1` las muestra, y quien lo activa asume la responsabilidad. Aun así, las
# imágenes cuya licencia no se ha podido verificar siguen sin embeberse: una
# bandera general no puede pasar por encima de un dato que dice «no lo sé».
IMAGENES_EMBED=0
