    "check:db": "tsx tools/check-db.ts",
    "check:shop": "tsx tools/check-shop.ts",
    "check:rival": "tsx tools/check-rival.ts",
    "check:gear": "tsx tools/check-gear.ts",
    "check:pvp": "tsx tools/check-pvp.ts",
    "check:evolution": "tsx tools/check-evolution.ts",
    "check:dungeon": "tsx tools/check-dungeon.ts",
    "check:missions": "tsx tools/check-missions.ts",
